# Copy to .env.local for local development. On Vercel, add these in Project Settings -> Environment Variables.
# Every variable is OPTIONAL. With none set, the app runs on demo data with temporary in-memory storage and a rule-based explanation.
# Never commit real values. Never prefix these with NEXT_PUBLIC_ (that would expose them to the browser).

# --- Market data ---
# auto (default): use Alpha Vantage when ALPHAVANTAGE_API_KEY is set, otherwise demo data. "mock" forces demo data.
MARKET_DATA_PROVIDER=auto
ALPHAVANTAGE_API_KEY=
# How long fetched market data is reused before a refresh (default 21600 = 6 hours). Protects free-tier quotas.
MARKET_CACHE_TTL_SECONDS=21600

# --- AI explanations ---
ANTHROPIC_API_KEY=
# Model used for explanations. Change it without touching code.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database (Supabase / Postgres) ---
SUPABASE_URL=
# Server-side only. Use the service_role key and keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
